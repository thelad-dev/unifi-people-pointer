{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Device registry for UniFi People Pointer (docs/datenmodell.md)",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "devices": {
      "type": "array",
      "description": "List of registered devices",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable device key referenced from people.device_ids",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Friendly device name",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Device type",
            "enum": [
              "smartphone",
              "laptop",
              "tablet",
              "desktop",
              "wearable",
              "iot",
              "other"
            ]
          },
          "manufacturer_id": {
            "type": ["string", "null"],
            "description": "Reference to manufacturers.json id"
          },
          "mac": {
            "type": "string",
            "description": "WLAN MAC address",
            "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
          },
          "hostname_match": {
            "type": "array",
            "description": "Exact or substring hostname tokens (not regex)",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "track": {
            "type": "boolean",
            "description": "Include device in presence matching",
            "default": true
          },
          "disabled": {
            "type": "boolean",
            "description": "Disable this device",
            "default": false
          },
          "notes": {
            "type": ["string", "null"],
            "description": "User notes"
          }
        },
        "required": ["id", "mac"],
        "additionalProperties": true
      }
    }
  },
  "required": ["devices"]
}
