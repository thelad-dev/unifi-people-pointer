{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "People configuration for UniFi People Pointer (docs/datenmodell.md)",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "people": {
      "type": "array",
      "description": "List of people to track",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique person ID (slug)",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Display name",
            "minLength": 1
          },
          "ha_person": {
            "type": "string",
            "description": "Home Assistant person entity id",
            "pattern": "^person\\.[a-z0-9_]+$"
          },
          "device_ids": {
            "type": "array",
            "description": "Ordered device ids from devices.json (first is primary)",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "notes": {
            "type": ["string", "null"],
            "description": "User notes"
          }
        },
        "required": ["id"],
        "additionalProperties": true
      }
    }
  },
  "required": ["people"]
}
