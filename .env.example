# UniFi Network Integration API Token
# Create token: UniFi Controller → Settings → Admins → Add Admin (View Only) → Generate API Token
unifi_api_token="your-api-token-here"

# Optional: UniFi Controller host (default: 192.168.88.1)
# unifi_controller_host="192.168.88.1"

# Optional: UniFi API port (default: 443)
# unifi_api_port="443"

# Optional: Verify SSL certificate (default: false)
# unifi_verify_ssl="false"
